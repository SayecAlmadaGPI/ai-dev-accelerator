---
// Card "Tu progreso" del landing. Isle vanilla: el estado se hidrata
// client-side desde localStorage (sin backend). La lista de ítems
// trackeables viene de src/data/trackable.json (generado por build-content
// desde modules/ + labs/). Escucha `aida:progress`, `aida:quiz` y `storage`
// para actualizarse en vivo (conteo, barra y línea de dominio).
import trackable from '../data/trackable.json';
import ProgressRing from './ProgressRing.astro';
import Badges from './Badges.astro';

const total = trackable.length;
const base = import.meta.env.BASE_URL;
const modules = trackable.filter((t) => t.group === 'modules');
// Total de módulos (11): para la línea de dominio del quiz.
const moduleTotal = modules.length;
const labs = trackable.filter((t) => t.group === 'labs');
---

<aside class="aida-progress" data-progress data-total={total}>
  <div class="aida-progress__top">
    <div class="aida-progress__heading">
      <svg class="aida-progress__ring" viewBox="0 0 48 48" aria-hidden="true">
        <circle class="ring-track" cx="24" cy="24" r="20"></circle>
        <circle class="ring-arc" cx="24" cy="24" r="20" data-progress-arc></circle>
      </svg>
      <div>
        <p class="aida-progress__title">Tu progreso</p>
        <p class="aida-progress__count">
          <strong data-progress-count>0</strong>
          <span>/ {total} completados</span>
        </p>
        <p class="aida-progress__dominio">
          Dominio: <strong data-progress-mastery>0</strong>/{moduleTotal} módulos (quiz ≥80%)
        </p>
      </div>
    </div>
    <div class="aida-progress__bar" aria-hidden="true"><span data-progress-bar></span></div>
    <p class="aida-progress__hint">Persiste en este navegador. Marca cada módulo o lab desde su página.</p>
    <div class="aida-io">
      <button class="aida-io__btn" data-io-export type="button">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Exportar
      </button>
      <button class="aida-io__btn" data-io-import type="button">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Importar
      </button>
    </div>
  </div>

  <div class="aida-progress__groups">
    <div class="aida-progress__group">
      <p class="aida-progress__grouplabel">Módulos</p>
      <ul>
        {modules.map((t) => (
          <li>
            <a class="aida-progress__item" href={base + t.slug + '/'}>
              <ProgressRing slug={t.slug} size="sm" />
              <span class="aida-progress__name">{t.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="aida-progress__group">
      <p class="aida-progress__grouplabel">Labs</p>
      <ul>
        {labs.map((t) => (
          <li>
            <a class="aida-progress__item" href={base + t.slug + '/'}>
              <ProgressRing slug={t.slug} size="sm" />
              <span class="aida-progress__name">{t.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <Badges />
</aside>
<script>
  import { listDone } from '../scripts/progress';
  import { readMasteryCount } from '../scripts/badges';

  const CIRC = 126;

  // El script módulo corre una sola vez por sesión, así que los listeners de
  // window se registran una sola vez (no se acumulan en view transitions).
  // render() re-consulta el DOM en cada llamada: hidrata el DOM nuevo de
  // cada página vía astro:page-load (primer load + navegaciones).
  function render() {
    const root = document.querySelector('[data-progress]');
    if (!root) return;
    const total = Number(root.getAttribute('data-total') || '0');
    const countEl = root.querySelector('[data-progress-count]');
    const arcEl = root.querySelector('[data-progress-arc]') as SVGCircleElement | null;
    const barEl = root.querySelector('[data-progress-bar]') as HTMLElement | null;
    const masteryEl = root.querySelector('[data-progress-mastery]');

    const done = listDone();
    const n = done.length;
    if (countEl) countEl.textContent = String(n);
    if (arcEl) arcEl.style.strokeDashoffset = String(CIRC * (1 - (total ? n / total : 0)));
    if (barEl) barEl.style.width = `${total ? (n / total) * 100 : 0}%`;
    // Dominio: módulos con bestPct ≥ 80 (re-leído de localStorage).
    if (masteryEl) masteryEl.textContent = String(readMasteryCount());
  }

  window.addEventListener('aida:progress', render);
  window.addEventListener('aida:quiz', render);
  window.addEventListener('storage', render);
  document.addEventListener('astro:page-load', render);
</script>

<style>
  .aida-progress {
    margin-top: clamp(1.5rem, 1rem + 3vw, 2.5rem);
    padding: clamp(1.25rem, 1rem + 2vw, 2rem);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 18px;
    background: color-mix(in srgb, var(--sl-color-bg-sidebar) 55%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow: var(--sl-shadow-md);
  }
  .aida-progress__top {
    border-bottom: 1px solid var(--sl-color-hairline);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }
  .aida-progress__heading {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .aida-progress__ring {
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    transform: rotate(-90deg);
  }
  .ring-track {
    fill: none;
    stroke: var(--sl-color-hairline);
    stroke-width: 4;
  }
  .ring-arc {
    fill: none;
    stroke: var(--sl-color-accent);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 126;
    stroke-dashoffset: 126;
    transition: stroke-dashoffset 0.4s ease;
  }
  .aida-progress__title {
    margin: 0;
    font-weight: 700;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
    letter-spacing: -0.01em;
  }
  .aida-progress__count {
    margin: 0.15rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .aida-progress__count strong {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-lg);
  }
  .aida-progress__dominio {
    margin: 0.3rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .aida-progress__dominio strong {
    color: var(--sl-color-text-accent);
  }
  .aida-progress__bar {
    margin-top: 0.9rem;
    height: 6px;
    border-radius: 999px;
    background: var(--sl-color-hairline);
    overflow: hidden;
  }
  .aida-progress__bar span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--sl-color-accent);
    transition: width 0.4s ease;
  }
  .aida-progress__hint {
    margin: 0.65rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .aida-progress__groups {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 40rem) {
    .aida-progress__groups {
      grid-template-columns: 1fr 1fr;
    }
  }
  .aida-progress__grouplabel {
    margin: 0 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-gray-3);
  }
  .aida-progress__groups ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .aida-progress__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.5rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .aida-progress__item:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    color: var(--sl-color-text);
  }
  .aida-progress__item .pr {
    flex-shrink: 0;
  }
  .aida-progress__name {
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
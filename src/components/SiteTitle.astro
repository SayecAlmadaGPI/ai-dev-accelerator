---
// Override del SiteTitle de Starlight: marca SVG inline (tile ámbar con
// doble chevron ">>" = aceleración) + wordmark. No usa config.logo (que
// es image-based); la marca vive aquí como SVG inline.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <svg class="aida-mark" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="aida-mark-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#e6c188"></stop>
        <stop offset="1" stop-color="#d4a056"></stop>
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="26" height="26" rx="7" fill="url(#aida-mark-grad)"></rect>
    <path
      d="M8.5 8 L14.5 14 L8.5 20"
      fill="none"
      stroke="#1a1208"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
    <path
      d="M14.5 8 L20.5 14 L14.5 20"
      fill="none"
      stroke="#1a1208"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.5"
    ></path>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    font-weight: 700;
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
    letter-spacing: -0.01em;
  }
  .site-title:hover {
    color: var(--sl-color-text-accent);
  }
  .site-title span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .aida-mark {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y) - 0.25rem);
    width: auto;
    flex-shrink: 0;
    border-radius: 6px;
    filter: drop-shadow(0 2px 6px rgba(212, 160, 86, 0.25));
    transition: transform 0.2s ease;
  }
  .site-title:hover .aida-mark {
    transform: translateY(-1px) scale(1.04);
  }
</style>

<script>
  // Boot de islas vanilla (Fase 4). Feature detection + import() dinámico por
  // mount-point: cada feature se code-splittea y solo carga en la página que
  // la necesita. Patrón consistente con Fase 3 (query [data-*], sin React).
  //
  // Con view transitions (astro-vtbot), el DOM se reemplaza en cada navegación.
  // Escuchamos `astro:page-load` (se dispara tras el swap) para reinicializar
  // las islas en la nueva página. El MutationObserver cubre el primer load y
  // cualquier render diferido.
  const base = import.meta.env.BASE_URL;

  // Registry de observers por selector: como bootIslands() corre en cada
  // astro:page-load, sin registry cada navegación sin widgets dejaría
  // observers huérfanos acumulándose. Con el Map queda a lo sumo 1 observer
  // vivo por selector y se desconecta al montar la feature.
  const observers = new Map<string, MutationObserver>();

  function bootFeature(selector: string, initFn: () => void): void {
    const el = document.querySelector(selector);
    // Al montar (o al re-bootear con el selector ya presente), suelta el
    // observer previo de ese selector si existía.
    observers.get(selector)?.disconnect();
    observers.delete(selector);
    if (el) {
      initFn();
      return;
    }
    const mo = new MutationObserver(() => {
      if (document.querySelector(selector)) {
        mo.disconnect();
        observers.delete(selector);
        initFn();
      }
    });
    observers.set(selector, mo);
    mo.observe(document.body, { childList: true, subtree: true });
  }

  function bootIslands() {
    bootFeature('[data-quiz-mount]', () =>
      import('../scripts/quiz.ts').then((m) => m.initQuizzes()),
    );
    bootFeature('[data-term-mount]', () =>
      import('../scripts/term.ts').then((m) => m.initTerm()),
    );
    bootFeature('[data-playground-mount]', () =>
      import('../scripts/playground.ts').then((m) => m.initPlayground()),
    );
    bootFeature('code.language-mermaid', () =>
      import('../scripts/mermaid.ts').then((m) => m.initMermaid()),
    );
  }

  // Primer load + navegaciones subsiguientes (view transitions).
  bootIslands();
  document.addEventListener('astro:page-load', bootIslands);

  // Notas: drawer flotante en toda página (carga siempre, módulo chico).
  // Se monta una sola vez en body; notes.ts escucha astro:page-load internamente
  // para recargar la nota de la página actual.
  import('../scripts/notes.ts').then((m) => m.initNotes(base));

  // Command palette (Cmd+K): carga siempre, índice ligero.
  import('../scripts/command-palette.ts').then((m) => m.initCommandPalette(base));

  // Badges: evaluación de logros desbloqueables.
  import('../scripts/badges.ts').then((m) => m.evaluateAndNotify());

  // Export/import de progreso.
  import('../scripts/progress-io.ts').then((m) => m.initProgressIO(base));

  // Scroll-spy del TOC.
  import('../scripts/scroll-spy.ts').then((m) => m.initScrollSpy());

  // Reading progress bar.
  import('../scripts/reading-bar.ts').then((m) => m.initReadingBar(base));

  // PWA: registro del service worker en toda página.
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register(base + 'sw.js', { scope: base });
  }
</script>